<%--
    header.jspf - common top of every page (static include):
        <% String pageTitle = "Dashboard"; %>
        <%@ include file="/WEB-INF/jspf/header.jspf" %>
    Reads the theme cookie (light / dark), prints <head> with the CSS files and the top header.
    A logged-in user also gets the search box, the notification bell, the account menu and the
    left sidebar (a bottom bar on phones). The application name comes from web.xml through
    application.getInitParameter("appName") (ServletContext).
    Variables defined here (do not redeclare them in the page): headerUser, themeValue,
    appName, ctx, unreadCount, simulationDate, currentPath.
    footer.jspf closes the <div> elements opened at the end of this file.
--%><%@ page import="com.aspirantos.model.User, com.aspirantos.dao.NotificationDAO, com.aspirantos.dao.SettingDAO, com.aspirantos.util.HtmlUtil, com.aspirantos.util.DateUtil, com.aspirantos.util.CategoryIcons" %><%!
    // One sidebar link. "match" lists the path prefixes (separated by |) that belong to this
    // link, so exam-detail.jsp keeps "Explore exams" highlighted. aria-current tells screen
    // readers which page is open. "extra" links are hidden in the phone bottom bar.
    private String sideLink(String ctx, String currentPath, String href, String match, String icon, String label, boolean extra) {
        boolean active = false;
        for (String m : match.split("\\|")) {
            if (currentPath.startsWith(m)) {
                active = true;
            }
        }
        return "<a href=\"" + ctx + href + "\"" + (extra ? " class=\"side-extra\"" : "")
                + (active ? " aria-current=\"page\"" : "") + ">"
                + CategoryIcons.svg(icon, "nav-icon", 22) + "<span>" + label + "</span></a>";
    }
%><%
    String ctx = request.getContextPath();
    String appName = application.getInitParameter("appName");
    User headerUser = (User) session.getAttribute("user");
    String currentPath = request.getRequestURI().substring(ctx.length());

    // theme cookie (set on the Settings page): "light" or "dark"
    String themeValue = "light";
    if (request.getCookies() != null) {
        for (jakarta.servlet.http.Cookie c : request.getCookies()) {
            if ("theme".equals(c.getName()) && "dark".equals(c.getValue())) {
                themeValue = "dark";
            }
        }
    }

    int unreadCount = headerUser == null ? 0 : new NotificationDAO().countUnread(headerUser.getId());
    java.time.LocalDate simulationDate = new SettingDAO().getSimulationDate();
    boolean headerAdmin = headerUser != null && "ADMIN".equals(headerUser.getRole());

    // initials for the account button: "Anshul Kaushik" -> "AK"
    String initials = "";
    if (headerUser != null) {
        for (String part : headerUser.getFullName().trim().split("\\s+")) {
            if (!part.isEmpty() && initials.length() < 2) {
                initials += Character.toUpperCase(part.charAt(0));
            }
        }
    }
%><!DOCTYPE html>
<html lang="en" data-theme="<%= themeValue %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="<%= themeValue %>">
<title><%= HtmlUtil.escape(pageTitle) %> - <%= HtmlUtil.escape(appName) %></title>
<link rel="preload" href="<%= ctx %>/assets/fonts/manrope-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="<%= ctx %>/assets/css/tokens.css">
<link rel="stylesheet" href="<%= ctx %>/assets/css/app.css">
<link rel="stylesheet" href="<%= ctx %>/assets/css/print.css" media="print">
</head>
<body class="<%= headerUser != null ? "signed-in" : "signed-out" %>">
<a class="skip-link" href="#main">Skip to content</a>
<% if (simulationDate != null) { %>
<div class="sim-banner" role="note">Simulation date: <%= DateUtil.format(simulationDate) %> &middot; all results use this date as today</div>
<% } %>
<header class="topbar">
    <a class="brand" href="<%= ctx %>/index.jsp"><span class="brand-mark" aria-hidden="true">A</span><span class="brand-name"><%= HtmlUtil.escape(appName) %></span></a>
    <% if (headerUser != null) { %>
    <form class="top-search" method="get" action="<%= ctx %><%= headerAdmin ? "/admin/exams.jsp" : "/aspirant/exams.jsp" %>" role="search">
        <label class="sr-only" for="top-q">Search exams</label>
        <%= CategoryIcons.svg("nav-explore", "search-icon", 18) %>
        <input type="search" id="top-q" name="q" maxlength="60" placeholder="Search exams - UPSC, CGL, NEET...">
    </form>
    <div class="top-actions">
        <a class="icon-button bell" href="<%= ctx %>/aspirant/notifications.jsp" aria-label="Notifications, <%= unreadCount %> unread"<%= currentPath.startsWith("/aspirant/notifications") ? " aria-current=\"page\"" : "" %>>
            <%= CategoryIcons.svg("nav-bell", "nav-icon", 22) %><% if (unreadCount > 0) { %><span class="badge mono" aria-hidden="true"><%= unreadCount > 99 ? "99+" : String.valueOf(unreadCount) %></span><% } %>
        </a>
        <details class="user-menu">
            <summary aria-label="Account menu of <%= HtmlUtil.escape(headerUser.getFullName()) %>"><span class="avatar" aria-hidden="true"><%= HtmlUtil.escape(initials) %></span><span class="user-name"><%= HtmlUtil.escape(headerUser.getFullName()) %></span></summary>
            <div class="menu-panel">
                <p class="menu-who"><strong><%= HtmlUtil.escape(headerUser.getFullName()) %></strong><br><span class="small muted"><%= HtmlUtil.escape(headerUser.getEmail()) %></span></p>
                <a href="<%= ctx %>/aspirant/settings.jsp"><%= CategoryIcons.svg("nav-settings", "nav-icon", 18) %>My settings</a>
                <a href="<%= ctx %>/about"><%= CategoryIcons.svg("nav-info", "nav-icon", 18) %>How it works</a>
                <a href="<%= ctx %>/logout.jsp"><%= CategoryIcons.svg("nav-logout", "nav-icon", 18) %>Log out</a>
            </div>
        </details>
    </div>
    <% } else { %>
    <nav class="topnav" aria-label="Main">
        <a href="<%= ctx %>/about">About</a>
        <a href="<%= ctx %>/login.jsp">Log in</a>
        <a class="btn btn-primary btn-small" href="<%= ctx %>/register.jsp">Create account</a>
    </nav>
    <% } %>
</header>
<div class="layout<%= headerUser != null ? " has-sidebar" : "" %>">
<% if (headerUser != null) { %>
<nav class="sidebar" aria-label="Main">
    <% if (headerAdmin) { %>
    <%= sideLink(ctx, currentPath, "/admin/dashboard.jsp", "/admin/dashboard", "nav-home", "Dashboard", false) %>
    <%= sideLink(ctx, currentPath, "/admin/exams.jsp", "/admin/exam|/admin/rules|/admin/docs-events", "nav-explore", "Exams", false) %>
    <%= sideLink(ctx, currentPath, "/admin/users.jsp", "/admin/users", "nav-users", "Users", false) %>
    <%= sideLink(ctx, currentPath, "/admin/reports.jsp", "/admin/reports", "nav-flag", "Reports", false) %>
    <%= sideLink(ctx, currentPath, "/admin/settings.jsp", "/admin/settings", "nav-settings", "Settings", false) %>
    <p class="side-heading side-extra">Tools</p>
    <%= sideLink(ctx, currentPath, "/admin/update-check.jsp", "/admin/update-check", "nav-refresh", "Update checks", true) %>
    <%= sideLink(ctx, currentPath, "/admin/rule-pack.jsp", "/admin/rule-pack", "nav-package", "Rule pack", true) %>
    <%= sideLink(ctx, currentPath, "/admin/audit.jsp", "/admin/audit", "nav-list", "Audit log", true) %>
    <%= sideLink(ctx, currentPath, "/admin/db-explorer.jsp", "/admin/db-explorer", "nav-database", "DB Explorer", true) %>
    <% } else { %>
    <%= sideLink(ctx, currentPath, "/aspirant/dashboard.jsp", "/aspirant/dashboard", "nav-home", "Dashboard", false) %>
    <%= sideLink(ctx, currentPath, "/aspirant/exams.jsp", "/aspirant/exam", "nav-explore", "Explore", false) %>
    <%= sideLink(ctx, currentPath, "/aspirant/horizon.jsp", "/aspirant/horizon", "nav-horizon", "Horizon", false) %>
    <%= sideLink(ctx, currentPath, "/aspirant/calendar.jsp", "/aspirant/calendar", "nav-calendar", "Calendar", false) %>
    <%= sideLink(ctx, currentPath, "/aspirant/journal.jsp", "/aspirant/journal", "nav-journal", "Journal", false) %>
    <%= sideLink(ctx, currentPath, "/aspirant/profile-step1.jsp", "/aspirant/profile-step", "nav-profile", "Profile", false) %>
    <% } %>
</nav>
<% } %>
<div class="content">
<main id="main" class="page">
