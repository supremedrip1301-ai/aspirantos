<%--
    admin-check.jspf - included at the top of every admin page:
        <%@ include file="/WEB-INF/jspf/admin-check.jspf" %>
    Same as auth-check.jspf, plus the role must be ADMIN; a student who types an admin URL
    is sent back to the student dashboard. After this fragment "currentUser" is the admin.
--%><%@ page import="com.aspirantos.model.User" %><%
    User currentUser = (User) session.getAttribute("user");
    if (currentUser == null) {
        session.setAttribute("error", "Please log in to continue.");
        response.sendRedirect(request.getContextPath() + "/login.jsp");
        return;
    }
    if (!"ADMIN".equals(currentUser.getRole())) {
        session.setAttribute("error", "That page is only for the administrator.");
        response.sendRedirect(request.getContextPath() + "/aspirant/dashboard.jsp");
        return;
    }
%>
