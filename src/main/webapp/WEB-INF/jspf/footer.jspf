<%--
    footer.jspf - common bottom of every page (static include):
        <%@ include file="/WEB-INF/jspf/footer.jspf" %>
    Closes <main> and the layout <div> elements opened by header.jspf, prints the footer and
    loads the shared script.
--%>
</main>
<footer class="site-footer">
    <p><%= com.aspirantos.util.HtmlUtil.escape(application.getInitParameter("appName")) %> &middot;
       Exam rules change every year - always confirm with the official notification before applying.</p>
</footer>
</div>
</div>
<script src="<%= request.getContextPath() %>/assets/js/app.js"></script>
</body>
</html>
